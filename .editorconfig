# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{Makefile,*.mk}]
indent_style = tab

[*.md]
indent_style = tab
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Packer (HCL2), Vagrant (Ruby), and shell provisioning scripts
[{*.hcl,*.rb,Vagrantfile,*.sh,*.cfg,*.ks}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4
