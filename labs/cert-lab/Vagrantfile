# Vagrantfile — two-tier PKI lab on the Packer-built Rocky Linux 8 box
#
#   root-ca     offline root CA (keep halted except when signing)
#   issuing-ca  intermediate / issuing CA
#   client      web server that requests certs and trusts the chain
#
# All three share a private libvirt network (ca-lab) with static IPs and
# /etc/hosts entries, so they can reach each other as <name>.lab.test.
# Provisioning is Ansible (provision/site.yml) using the shared roles in ../../ansible/roles.

BOX    = "local/rocky-8"
DOMAIN = "lab.test" # .test is reserved for testing (RFC 2606), never real DNS

NODES = {
  "root-ca"    => "192.168.150.10",
  "issuing-ca" => "192.168.150.11",
  "client"     => "192.168.150.12",
}

Vagrant.configure("2") do |config|
  config.vm.box = BOX

  config.ssh.username = "vagrant"
  config.ssh.password = "vagrant"

  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider :libvirt do |lv|
    lv.uri    = "qemu:///system"
    lv.driver = "kvm"
    lv.cpus   = 1
    lv.memory = 1024
  end

  NODES.each do |name, ip|
    config.vm.define name do |node|
      node.vm.hostname = "#{name}.#{DOMAIN}"
      node.vm.network :private_network,
        ip: ip,
        libvirt__network_name: "ca-lab"

      # Runs per machine; lab_base_ip for every host is in the generated inventory,
      # so each VM gets the full /etc/hosts even when brought up alone.
      node.vm.provision "ansible" do |ansible|
        ansible.playbook    = "provision/site.yml"
        ansible.config_file = "../../ansible.cfg"
        ansible.host_vars   = NODES.to_h { |n, i| [n, { "lab_base_ip" => i }] }
        ansible.groups      = { "ca" => ["root-ca", "issuing-ca"], "web" => ["client"] }
        ansible.extra_vars  = { "lab_base_domain" => DOMAIN }
      end
    end
  end
end
